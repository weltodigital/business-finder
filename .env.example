# Companies House (https://developer.company-information.service.gov.uk/)
# Same key works for the Public Data API and the Document API.
COMPANIES_HOUSE_API_KEY=

# Supabase
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Anthropic (AI target analysis + LLM accounts extraction fallback)
ANTHROPIC_API_KEY=

# Optional enrichment (leave blank to disable that enrichment step)
GOOGLE_MAPS_API_KEY=
FIRECRAWL_API_KEY=

# Local development: use fixture data instead of live Companies House calls
USE_FIXTURES=false
